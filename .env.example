# === База данных приложения ===
# Локальный запуск (без Docker) — SQLite по умолчанию.
# В docker-compose значение переопределяется на postgres://blog:blog@db:5432/blog.
DATABASE_URL=sqlite:///./sqlite.db

# === Креды PostgreSQL (используются сервисом db в docker-compose) ===
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# === Безопасность / JWT ===
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Логирование ===
LOG_LEVEL=INFO

# === HTTP-сервер ===
APP_HOST=0.0.0.0
APP_PORT=8000
