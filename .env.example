# === База данных ===
# Локально: sqlite+aiosqlite. В Docker переопределяется на postgresql+asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./sqlite.db

# === PostgreSQL (docker-compose) ===
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# === JWT ===
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Логирование ===
LOG_LEVEL=INFO

# === Сервер ===
APP_HOST=0.0.0.0
APP_PORT=8000

# === Загрузка изображений постов ===
UPLOAD_DIR=uploads
